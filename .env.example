# Project Sofia — Environment Variables
# Скопируйте в .env и настройте под себя:
#   cp .env.example .env

# ─── LLM-провайдер (OpenAI-совместимый /v1) ───────────────
# ollama   — нативная Ollama (localhost:11434)
# llamacpp — llama-server с GGUF (scripts/start_llm_server.ps1, :8080)
# jan      — Jan Local API Server (:1337)
# openai   — любой внешний OpenAI-совместимый сервер
LLM_PROVIDER=ollama

# Явные переопределения (нужны редко — обычно достаточно LLM_PROVIDER)
# LLM_BASE_URL=http://127.0.0.1:8080
# LLM_API_KEY=none

# Ollama (используется, когда LLM_PROVIDER=ollama,
# а также для эмбеддингов памяти)
OLLAMA_HOST=http://localhost:11434

# ─── Модели ───────────────────────────────────────────────
# Для llamacpp имя = --alias из scripts/start_llm_server.ps1
# MODEL_BRAIN=qwythos-9b
# MODEL_EXTRACTOR=qwythos-9b

# ─── Безопасность ─────────────────────────────────────────
# strict | standard | permissive
SAFETY_MODE=standard

# ─── API ──────────────────────────────────────────────────
API_PORT=8000
# 0.0.0.0 открывает API всей локальной сети — ставьте осознанно.
API_HOST=127.0.0.1

# ─── Профиль (target = ноутбук с GPU, dev = VDS без GPU) ───
# SOFIA_PROFILE=target

# ─── XTTS (опционально: путь к конкретному чекпоинту) ──────
# XTTS_MODEL_PATH=
